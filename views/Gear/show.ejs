<%- include('../partials/layout/top') %>

<nav class="small mb-2"><a href="/gear">&larr; All gear</a></nav>
<div class="card shadow-sm mb-4">
  <div class="card-body">
    <div class="d-flex justify-content-between align-items-start">
      <div>
        <h1 class="h3 mb-1"><%= gear.name %></h1>
        <p class="text-muted mb-2"><%= gear.category %> &middot; <%= gear.condition %> condition &middot; $<%= Number(gear.dailyFee).toFixed(2) %>/day</p>
        <%- include('../partials/components/status-badge', { available: isAvailable }) %>
      </div>
      <div class="text-end">
        <a href="/gear/<%= gear.id %>/edit" class="btn btn-outline-secondary btn-sm">Edit</a>
        <% if (isAvailable) { %>
          <a href="/checkouts/new" class="btn btn-primary btn-sm">Check out</a>
        <% } %>
      </div>
    </div>
    <% if (gear.description) { %>
      <p class="mt-3 mb-0"><%= gear.description %></p>
    <% } %>
  </div>
</div>

<h2 class="h5 mb-3">Checkout history</h2>
<%- include('../partials/components/checkout-table', { checkouts: history, today: today, emptyMessage: 'This item has never been checked out.' }) %>

<%- include('../partials/layout/bottom') %>
