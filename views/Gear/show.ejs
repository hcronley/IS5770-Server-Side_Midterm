<%- include('../partials/layout/top') %>

    <nav class="small mb-2"><a href="/gear">&larr; All gear</a></nav>
    <div class="card shadow-sm mb-4">
        <div class="card-body">
            <div class="d-flex justify-content-between align-items-start">
                <div>
                    <h1 class="h3 mb-1">
                        <%= gear.name %>
                    </h1>
                    <p class="text-muted mb-2">
                        <%= gear.category %> &middot; <%= gear.condition %> condition &middot; $<%=
                                    Number(gear.dailyFee).toFixed(2) %>/day
                    </p>
                    <% if (isAvailable) { %>
                        <span class="badge bg-success">Available</span>
                        <% } else { %>
                            <span class="badge bg-secondary">Checked out</span>
                            <% } %>
                </div>
                <div class="text-end">
                    <a href="/gear/<%= gear.id %>/edit" class="btn btn-outline-secondary btn-sm">Edit</a>
                    <% if (isAvailable) { %>
                        <a href="/checkouts/new" class="btn btn-primary btn-sm">Check out</a>
                        <% } %>
                </div>
            </div>
            <% if (gear.description) { %>
                <p class="mt-3 mb-0">
                    <%= gear.description %>
                </p>
                <% } %>
        </div>
    </div>

    <h2 class="h5 mb-3">Checkout history</h2>

    <div class="table-responsive">
        <table class="table table-hover align-middle bg-white shadow-sm rounded">
            <thead class="table-light">
                <tr>
                    <th>Gear</th>
                    <th>Member</th>
                    <th>Checked out</th>
                    <th>Status</th>
                    <th></th>
                </tr>
            </thead>
            <tbody>
                <% history.forEach(function (checkout) { %>
                    <tr>
                        <td><a href="/gear/<%= checkout.gear.id %>">
                                <%= checkout.gear.name %>
                            </a></td>
                        <td><a href="/members/<%= checkout.member.id %>">
                                <%= checkout.member.getFullName() %>
                            </a></td>
                        <td>
                            <%= checkout.checkedOutOn %>
                        </td>
                        <td>
                            <% if (checkout.returnedOn) { %>
                                Returned <%= checkout.returnedOn %>
                                    <% } else if (checkout.dueOn < today) { %>
                                        <span class="badge bg-danger">Overdue (due <%= checkout.dueOn %>)</span>
                                        <% } else { %>
                                            <span class="badge bg-secondary">Due <%= checkout.dueOn %></span>
                                            <% } %>
                        </td>
                        <td class="text-end">
                            <% if (!checkout.returnedOn) { %>
                                <form method="POST" action="/checkouts/<%= checkout.id %>/return" class="d-inline">
                                    <button class="btn btn-outline-primary btn-sm">Mark returned</button>
                                </form>
                                <% } %>
                        </td>
                    </tr>
                    <% }) %>
            </tbody>
        </table>
    </div>

    <%- include('../partials/layout/bottom') %>