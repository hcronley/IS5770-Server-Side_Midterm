<%- include('../partials/layout/top') %>

    <% const g=gear || {}; %>

        <nav class="small mb-2"><a href="<%= gear ? '/gear/' + gear.id : '/gear' %>">&larr; Back</a></nav>
        <div class="row justify-content-center">
            <div class="col-lg-7">
                <div class="card shadow-sm">
                    <div class="card-body">
                        <h1 class="h4 mb-3">
                            <%= title %>
                        </h1>

                        <form method="POST" action="<%= action %>">
                            <div class="mb-3">
                                <label class="form-label" for="name">Name</label>
                                <input class="form-control" id="name" name="name" value="<%= g.name || '' %>" required>
                            </div>
                            <div class="row">
                                <div class="col-md-6 mb-3">
                                    <label class="form-label" for="category">Category</label>
                                    <input class="form-control" id="category" name="category"
                                        value="<%= g.category || '' %>" placeholder="Camping, Hiking, Winter..."
                                        required>
                                </div>
                                <div class="col-md-3 mb-3">
                                    <label class="form-label" for="condition">Condition</label>
                                    <select class="form-select" id="condition" name="condition">
                                        <% ["Excellent", "Good" , "Fair" , "Needs Repair" ].forEach(function (opt) { %>
                                            <option <%=opt===(g.condition || "Good" ) ? "selected" : "" %>><%= opt %>
                                            </option>
                                            <% }) %>
                                    </select>
                                </div>
                                <div class="col-md-3 mb-3">
                                    <label class="form-label" for="dailyFee">Daily fee ($)</label>
                                    <input class="form-control" id="dailyFee" name="dailyFee" type="number" min="0"
                                        step="0.5" value="<%= g.dailyFee !== undefined ? g.dailyFee : '' %>">
                                </div>
                            </div>
                            <div class="mb-3">
                                <label class="form-label" for="description">Description</label>
                                <textarea class="form-control" id="description" name="description"
                                    rows="3"><%= g.description || '' %></textarea>
                            </div>
                            <button class="btn btn-primary">Save</button>
                        </form>
                    </div>
                </div>
            </div>
        </div>

        <%- include('../partials/layout/bottom') %>